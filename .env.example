# Credentials for the opt-in LIVE integration suites. Both suites are skipped
# when their variables are unset, so contributors without accounts are never
# blocked and CI never needs secrets.
#
#   1. cp .env.example .env
#   2. fill in the TEST/sandbox values below
#   3. ./run_integration.sh            (all suites)
#      ./run_integration.sh -k phonepe (one suite)
#
# .env is gitignored on purpose: never commit real credentials.

# --- Razorpay TEST (sandbox) ------------------------------------------------
# Dashboard -> Account & Settings -> API Keys (Test mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# --- PhonePe pre-production (sandbox) ---------------------------------------
# PhonePe dashboard -> Developer Settings -> Client id / Client secret.
# The merchant id is PhonePe's "client id"; the salt key is the client secret.
PHONEPE_MERCHANT_ID=your_phonepe_client_id
PHONEPE_SALT_KEY=your_phonepe_client_secret
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=preprod
