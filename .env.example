# Razorpay TEST (sandbox) credentials for the opt-in integration suite.
#
#   1. cp .env.example .env
#   2. fill in keys from the Razorpay dashboard (Test mode)
#   3. ./run_integration.sh
#
# .env is gitignored on purpose: never commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
